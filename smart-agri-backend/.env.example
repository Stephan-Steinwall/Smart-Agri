OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# Supabase Configuration
SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# WhatsApp Cloud API (Meta 100% Free Tier for OTP Verification)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=

# Twilio (optional fallback SMS provider; if unset, OTP falls back to a
# simulated gateway that returns the code directly in the API response)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Session signing -- generate your own, e.g. `openssl rand -hex 48`
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGIN=http://localhost:3000

# ml_backend (FastAPI + RandomForest crop model) base URL
ML_API_URL=http://127.0.0.1:8000

# Fixed physical location of the farm's sensor node (used for rain-prediction
# regional forecast lookups, NOT the browser's location)
FARM_LATITUDE=6.9271
FARM_LONGITUDE=79.8612

# Portable sensor calibration (leave unset to keep an "uncalibrated
# demonstration" PAW mode)
EC_SENSOR_UNIT=dS/m
# SOIL_FIELD_CAPACITY=
# SOIL_WILTING_POINT=
