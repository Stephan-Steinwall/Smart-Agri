{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start:dev", "--prefix", "smart-agri-backend"],
      "port": 3001
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "smart-agri-frontend"],
      "port": 3000
    },
    {
      "name": "ml-backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "ml:serve"],
      "port": 8000
    }
  ]
}
